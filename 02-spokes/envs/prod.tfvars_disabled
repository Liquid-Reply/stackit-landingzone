# Production Environment
#
# First apply:  leave enable_services = false (creates project, SNA, network, IAM)
# Second apply: set enable_services = true  (creates observability, gateway)

region                   = "eu01"
service_account_key_path = "sa-key.json"
private_key_path         = "sa-key.pem"
organization_id          = "<YOUR_ORGANIZATION_ID>"

environment       = "prod"
project_name      = "landingzone-spoke-prod"
owner_email       = ""
billing_reference = ""
network_name    = "prod-network"
dns_subdomain   = "prod"
enable_services = false

# SNA - Production environment IP space (isolated from dev/staging)
sna_network_ranges        = [{ prefix = "10.2.0.0/16" }]
sna_transfer_network      = "10.255.2.0/24"
sna_default_prefix_length = 24

# Observability
observability_plan     = "Observability-Starter-EU01"
metrics_retention_days = 180
logs_retention_days    = 90

# Gateway (subnet router / bastion)
gateway_machine_type = "g2i.1"
gateway_image_id     = ""  # STACKIT Ubuntu image UUID – find via: stackit beta server image list
ssh_public_key       = ""
allowed_ssh_cidrs    = ["203.0.113.0/24"]

scrape_targets = []

# NetBird VPN agent - set to true after NetBird server is running and hub PAT is retrieved
enable_netbird_agent = false

# IAM - Strict access: only platform team has access (via owner_email + hub SAs)
project_role_assignments = []
