# Project Request: Team Alpha - Development
# To request a new project, copy this template and submit a PR.

project_name: "team-alpha-dev"
team: "alpha"
environment: "dev"
owner_email: "alpha-lead@example.com"
billing_reference: ""

# Team members and their access level
# Roles: owner, editor, reader
members:
  - email: "alpha-dev1@example.com"
    role: "editor"
  # - email: "alpha-dev1@example.com"
  #   role: "editor"
  # - email: "alpha-dev2@example.com"
  #   role: "editor"

# Optional extra labels
extra_labels:
  cost_center: "cc-1234"
  application: "my-app"

# DNS - each project automatically gets a delegated zone:
#   team-alpha-dev.dev.<your-domain> (e.g., team-alpha-dev.dev.example.com)
# Teams can then self-manage records via the STACKIT portal.

# Firewall - additional ingress rules (reviewed and approved by platform team)
# Hub SSH + HTTPS ingress is always allowed. Add rules here for cross-project access.
